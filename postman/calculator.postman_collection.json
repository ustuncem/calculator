            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expression\":\"0.1 + 0.2\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns the expected decimal and rounding flag', () => {",
              "    pm.expect(pm.response.json()).to.eql({\"result\":\"0.3\",\"rounded\":false});",
