    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
